{{- if (eq .chezmoi.os "linux" "darwin") }}
# Modern command replacements
# eza aliases (modern ls replacement)
if command -v eza >/dev/null 2>&1; then
    alias ll='eza -la --group-directories-first --icons'
    alias la='eza -la --group-directories-first --icons'
    alias l='eza -1 --group-directories-first --icons'
    alias ls='eza --group-directories-first --icons'
    alias lt='eza -T --group-directories-first --icons'  # tree view
    alias lg='eza -la --git --group-directories-first --icons'  # show git status
else
    # Fallback to traditional ls with colors
    alias ll='ls -la --color=auto'
    alias la='ls -la --color=auto'
    alias l='ls -1 --color=auto'
    alias ls='ls --color=auto'
fi

# bat alias for cat (syntax highlighting)
if command -v bat >/dev/null 2>&1; then
    alias cat='bat'
fi

# Git shortcuts
alias gs='git status'
alias ga='git add .'
alias gc='git commit'
alias gp='git push'

{{- if eq .wsl true }}
# WSL-specific aliases for Windows SSH
alias ssh='ssh.exe'
alias ssh-add='ssh-add.exe'
{{- end }}

{{- if (or (eq .pmode true) (eq .oagmode true)) }}
# Bitwarden helper function
function bwu {
    if ! command -v bw >/dev/null 2>&1; then
        echo "Error: Bitwarden CLI (bw) not found. Please install it first."
        return 1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        echo "Error: jq not found. Please install it for JSON parsing."
        return 1
    fi

    BW_STATUS=$(bw status | jq -r .status)
    case "$BW_STATUS" in
    "unauthenticated")
        echo "Logging into Bitwarden..."
        export BW_SESSION=$(bw login --raw)
        ;;
    "locked")
        echo "Unlocking Vault..."
        export BW_SESSION=$(bw unlock --raw)
        ;;
    "unlocked")
        echo "Vault is already unlocked"
        ;;
    *)
        echo "Unknown login status: $BW_STATUS"
        return 1
        ;;
    esac
    
    echo "Syncing vault..."
    bw sync
}
{{- end }}

# Chezmoi wrapper function
function cz() (
{{- if (or (eq .pmode true) (eq .oagmode true)) }}
    if ! command -v bw >/dev/null 2>&1; then
        echo "Warning: Bitwarden CLI not found, running chezmoi without authentication"
        command chezmoi "$@"
        return
    fi
    # Reuse existing session if vault is already unlocked; only unlock when needed.
    BW_STATUS=$(bw status | jq -r .status)
    case "$BW_STATUS" in
    "unauthenticated")
        echo "Logging into Bitwarden..."
        export BW_SESSION=$(bw login --raw)
        ;;
    "locked")
        echo "Unlocking Bitwarden vault..."
        export BW_SESSION=$(bw unlock --raw)
        ;;
    "unlocked")
        # Session already active; ensure BW_SESSION is exported for chezmoi templates.
        export BW_SESSION="${BW_SESSION}"
        ;;
    *)
        echo "Warning: Unknown Bitwarden status '$BW_STATUS', attempting unlock..."
        export BW_SESSION=$(bw unlock --raw)
        ;;
    esac
{{- else if eq .ptxmode true }}
    if ! command -v op >/dev/null 2>&1; then
        echo "Warning: 1Password CLI not found, running chezmoi without authentication"
        command chezmoi "$@"
        return
    fi
    
    # Check if already signed in to 1Password
    if ! op account list >/dev/null 2>&1; then
        echo "Not signed in to 1Password. Please sign in..."
        op signin
        
        if [ $? -ne 0 ]; then
            echo "Error: Failed to authenticate with 1Password"
            return 1
        fi
        echo "1Password authentication successful"
    fi
{{- end }}
    command chezmoi "$@"
)

{{- if (and (eq .chezmoi.os "darwin") (eq .oagmode true)) }}
# macOS Privileges.app integration
if [ -f "/Applications/Privileges.app/Contents/Resources/PrivilegesCLI" ]; then
    alias privileges="/Applications/Privileges.app/Contents/Resources/PrivilegesCLI"
    alias sudo="privileges --add 2>/dev/null; sudo"
fi
{{- end }}

{{- if (and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "pop")) }}
# VS Code via Flatpak on Pop!_OS
function code() {
    flatpak run com.visualstudio.code "$@"
}
{{- end }}

# Network utilities
function pubip {
    if command -v curl >/dev/null 2>&1; then
        curl -s http://ifconfig.me/ip -w "\n"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- http://ifconfig.me/ip && echo
    else
        echo "Error: Neither curl nor wget is available"
        return 1
    fi
}

# System utilities
function reload-profile {
    if [ -f ~/.bashrc ]; then
        source ~/.bashrc
        echo "Bash profile reloaded"
    else
        echo "Error: ~/.bashrc not found"
        return 1
    fi
}

alias rp='reload-profile'

{{- if eq .ptxmode true }}
# AWS SSO helpers — requires AWS CLI v2 and jq

# Find a valid access token from the local SSO token cache (newest file first)
function _aws_sso_find_token {
    ls -t "${HOME}/.aws/sso/cache/"*.json 2>/dev/null | while IFS= read -r f; do
        local t
        t=$(jq -r '.accessToken // empty' "$f" 2>/dev/null)
        [ -n "$t" ] && printf '%s' "$t" && return
    done
}

# Generate/update ~/.aws/config by querying all accessible SSO accounts and roles.
# Compatible with both 'aws sso login' (AWS CLI v2) and aws-vault v6+.
# Usage: aws-config-update [--sso-region REGION] [--region DEFAULT_REGION]
function aws-config-update {
    local SSO_START_URL={{ (index (onepasswordItemFields "chezmoi") "aws-sso-start-url").value | quote }}
    local SSO_REGION="${AWS_SSO_REGION:-us-west-2}"
    local SSO_SESSION_NAME={{ (index (onepasswordItemFields "chezmoi") "aws-sso-session-name").value | quote }}
    local AWS_CONFIG="${HOME}/.aws/config"
    local DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-west-2}"
    local DEFAULT_OUTPUT="json"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --sso-region) SSO_REGION="$2";     shift 2 ;;
            --region)     DEFAULT_REGION="$2"; shift 2 ;;
            *) echo "Unknown option: $1"; return 1 ;;
        esac
    done

    if ! command -v aws >/dev/null 2>&1; then
        echo "Error: AWS CLI v2 not found. See https://aws.amazon.com/cli/"
        return 1
    fi
    if ! command -v jq >/dev/null 2>&1; then
        echo "Error: jq not found. Install with: brew install jq"
        return 1
    fi

    local TOKEN
    TOKEN=$(_aws_sso_find_token)

    if [ -z "$TOKEN" ]; then
        echo "[-] No cached SSO token — initiating login [-]"

        # Bootstrap a minimal sso-session block so 'aws sso login' can find the start URL
        mkdir -p "${HOME}/.aws"
        if ! grep -qs "sso-session ${SSO_SESSION_NAME}" "${AWS_CONFIG}" 2>/dev/null; then
            printf "\n[sso-session %s]\nsso_start_url = %s\nsso_region = %s\nsso_registration_scopes = sso:account:access\n" \
                "$SSO_SESSION_NAME" "$SSO_START_URL" "$SSO_REGION" >> "$AWS_CONFIG"
        fi

        if ! aws sso login --sso-session "$SSO_SESSION_NAME"; then
            echo "Error: SSO login failed."
            return 1
        fi
        TOKEN=$(_aws_sso_find_token)
    fi

    if [ -z "$TOKEN" ]; then
        echo "Error: Could not retrieve access token after login."
        return 1
    fi

    echo "[-] Fetching accounts from AWS SSO [-]"
    local ACCOUNTS_JSON
    ACCOUNTS_JSON=$(aws sso list-accounts \
        --access-token "$TOKEN" --region "$SSO_REGION" --output json 2>/dev/null)

    if ! printf '%s' "$ACCOUNTS_JSON" | jq -e '.accountList | length > 0' >/dev/null 2>&1; then
        echo "Error: No accounts returned. SSO session may be expired — re-run to log in again."
        return 1
    fi

    if [ -f "$AWS_CONFIG" ]; then
        cp "$AWS_CONFIG" "${AWS_CONFIG}.bak"
        echo "Backed up existing config to ${AWS_CONFIG}.bak"
    fi

    mkdir -p "${HOME}/.aws"

    {
        printf "# AWS config — generated by aws-config-update on %s\n" "$(date)"
        printf "# Run aws-config-update to refresh all profiles\n\n"
        printf "[default]\nregion = %s\noutput = %s\n\n" "$DEFAULT_REGION" "$DEFAULT_OUTPUT"
        printf "[sso-session %s]\n" "$SSO_SESSION_NAME"
        printf "sso_start_url = %s\n" "$SSO_START_URL"
        printf "sso_region = %s\n" "$SSO_REGION"
        printf "sso_registration_scopes = sso:account:access\n\n"
    } > "$AWS_CONFIG"

    local PROFILE_COUNT=0

    while IFS= read -r ACCOUNT; do
        local ACCOUNT_ID ACCOUNT_NAME ROLES
        ACCOUNT_ID=$(printf '%s' "$ACCOUNT" | jq -r '.accountId')
        ACCOUNT_NAME=$(printf '%s' "$ACCOUNT" | jq -r '.accountName')

        ROLES=$(aws sso list-account-roles \
            --access-token "$TOKEN" --account-id "$ACCOUNT_ID" \
            --region "$SSO_REGION" --output json 2>/dev/null \
            | jq -r '.roleList[].roleName' 2>/dev/null)

        if [ -z "$ROLES" ]; then
            echo "  Skipping $ACCOUNT_NAME — no accessible roles"
            continue
        fi

        while IFS= read -r ROLE_NAME; do
            [ -z "$ROLE_NAME" ] && continue

            # Normalize: lowercase, spaces/slashes → hyphens, strip non-alphanumeric, collapse repeats
            local PROFILE_NAME
            PROFILE_NAME=$(printf '%s-%s' "$ACCOUNT_NAME" "$ROLE_NAME" \
                | tr '[:upper:]' '[:lower:]' \
                | tr '[:space:]/' '-' \
                | tr -cd '[:alnum:]-_' \
                | sed 's/--*/-/g; s/^-//; s/-$//')

            {
                printf "# %s (%s)\n" "$ACCOUNT_NAME" "$ACCOUNT_ID"
                printf "[profile %s]\n" "$PROFILE_NAME"
                printf "sso_session = %s\n" "$SSO_SESSION_NAME"
                printf "sso_account_id = %s\n" "$ACCOUNT_ID"
                printf "sso_role_name = %s\n" "$ROLE_NAME"
                printf "region = %s\n" "$DEFAULT_REGION"
                printf "output = %s\n\n" "$DEFAULT_OUTPUT"
            } >> "$AWS_CONFIG"

            PROFILE_COUNT=$((PROFILE_COUNT + 1))
            echo "  + ${PROFILE_NAME}  (${ROLE_NAME})"
        done <<< "$ROLES"
    done < <(printf '%s' "$ACCOUNTS_JSON" | jq -c '.accountList[]')

    printf "\n[-] Done: %d profile(s) written to %s [-]\n" "$PROFILE_COUNT" "$AWS_CONFIG"

    if command -v aws-vault >/dev/null 2>&1; then
        printf "aws-vault: 'aws-vault exec <profile> -- <cmd>'  or  'aws-vault login <profile>'\n"
    fi
}
{{- end }}

